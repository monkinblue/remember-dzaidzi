      "id": "ch-1",
      "index": "I",
      "title": "“To Those Interested in My Life” — 41 Elm Street & Binghamton Roots",
      "startTime": 0,
      "summary": "Growing up the oldest of ten children in a Slovak and Rusyn immigrant family in Binghamton, New York—paper routes, Grandma Buchta’s Sunday chickens, Ozalid, and learning golf from his father.",
      "journalPages": [
        "intro-1",
        "9",
        "11",
        "12",
        "14",
        "52"
      ]
    },
    {
      "id": "ch-2",
      "index": "II",
      "title": "Le Moyne, Quitting Med School & Meeting Longina at a 22nd Baptism",
      "startTime": 417,
      "summary": "A Gannett paperboy scholarship to Le Moyne College, leaving medical school in 1962, becoming a “90-day wonder” 2nd Lieutenant at Lackland OTS, and falling for Longina Fisch.",
      "journalPages": [
        "10",
        "56",
        "58",
        "67",
        "70",
        "74"
      ]
    },
    {
      "id": "ch-3",
      "index": "III",
      "title": "1st Combat Applications Group & Vietnam-Era Weapons Flight Testing",
      "startTime": 862,
      "summary": "Flying test missions out of Eglin and Hurlburt Field aboard C-130s, A-1 Skyraiders, and B-26s—testing jungle flares, cluster munitions, and low-light cameras before earning his master’s at RPI.",
      "journalPages": [
        "75",
        "76",
        "78",
        "79",
        "80"
      ]
    },
    {
      "id": "ch-4",
      "index": "IV",
      "title": "The A-10 “Tank-Killer” 30mm GAU-8 Program & Full Bull Colonel",
      "startTime": 1304,
      "summary": "Leading the 30mm depleted-uranium ammunition development that turned the A-10 Thunderbolt II into a legend for ground troops, attaining O-6 Colonel, and 13 post-military years at SenCom on missile defense.",
      "journalPages": [
        "81",
        "82",
        "232",
        "234"
      ]
    },
    {
      "id": "ch-5",
      "index": "V",
      "title": "Grief, Resilience & Finding Joy Again with Tracy at 328 Lakewood Blvd",
      "startTime": 1805,
      "summary": "Losing Longina to breast cancer in 1990, hitchhiking through a Colorado blizzard to walk Monica down the aisle, meeting Tracy at SenCom, Cape Cod vows, and life in Maple Bluff.",
      "journalPages": [
        "69",
        "92",
        "104",
        "157",
        "205",
        "208",
        "231",
        "226"
      ]
