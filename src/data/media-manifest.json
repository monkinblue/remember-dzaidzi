    {
      "id": "ch-6",
      "index": "VI",
      "title": "Freezer-Door Chalk Cartoons, MARGA Golf & The July 4th Fireworks Bust",
      "startTime": 2334,
      "summary": "Drawing holiday chalk cartoons on the black garage freezer door, sinking a putt under an F-16 afterburner roar at Bridges, and getting busted for “gunfire at the beach” shooting Roman candles with grandson Robert.",
      "journalPages": [
        "98",
        "126",
